MONGO_URI=
DB_NAME=
PORT=
HOST=

# Aeko SDK. The SDK never reads the environment, so the API passes these in
# through `Aeko.config()`. Only the key is required; every model and token
# setting below falls back to the SDK's own default when left empty.
GEMINI_API_KEY=
AEKO_FAST_MODEL=
AEKO_SLOW_MODEL=
AEKO_MAX_TOKENS=
AEKO_REPORT_MAX_TOKENS=

# Tavily MCP (web search tools handed to Aeko, see cmd/api/mcp_config.py).
TAVILY_API_KEY=
# The site the FAQ agent's tavily_map tool is pinned to — it never chooses
# its own URL.
AETHER_WEB_SITE_URL=

# ChromaDB MCP (vector search over the `gases-info` collection, handed only to
# the "Analista de Gases Verdes" agent - see cmd/api/mcp/chroma_mcp.py).
# Chroma Cloud: the server connects to api.trychroma.com over SSL with these.
CHROMA_TENANT=
CHROMA_DATABASE=aeko-gases-vector-store
CHROMA_API_KEY=
