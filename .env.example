MONGO_URI=
DB_NAME=
PORT=
HOST=

# ms-inventory: the microservice that owns the inventory files. The report flow
# resolves an inventory as Markdown through it
# (GET {base}/aether-api/v1/ms-inventory/resolve/{id_external_inventory}), so
# this API never touches a bucket or a spreadsheet - see
# improvement_plan/integration/ms_inventory.py. Origin only, no trailing path.
MS_INVENTORY_BASE_URL=

# Aeko SDK. The SDK never reads the environment, so the API passes these in
# through `Aeko.config()`. Only the key is required; every model and token
# setting below falls back to the SDK's own default when left empty.
GEMINI_API_KEY=
AEKO_FAST_MODEL=
AEKO_SLOW_MODEL=
AEKO_MAX_TOKENS=
AEKO_REPORT_MAX_TOKENS=

# Tavily MCP (web search tools handed to Aeko, see cmd/api/mcp_config.py).
TAVILY_API_KEY=
# The site the FAQ agent's tavily_map tool is pinned to — it never chooses
# its own URL.
AETHER_WEB_SITE_URL=

# Every MCP server is started once, when the API starts, and kept open for the
# life of the process (see cmd/api/mcp/mcp_session.py) — otherwise each tool
# call would spawn its own server and pay its whole start-up. Set this to
# "false" to skip that warm-up and let the first tool call pay it instead.
AEKO_MCP_WARM_UP=true

# ChromaDB MCP (vector search over the `gases-info` collection, handed only to
# the "Analista de Gases Verdes" agent - see cmd/api/mcp/chroma_mcp.py).
# Chroma Cloud: the server connects to api.trychroma.com over SSL with these.
CHROMA_TENANT=
CHROMA_DATABASE=aeko-gases-vector-store
CHROMA_API_KEY=

# Climatiq (emission factor search + carbon calculation, handed only to the
# "Analista de Poluentes" agent - see cmd/api/integrations/climatiq_api.py).
# Not MCP: this one is a plain HTTPS call to api.climatiq.io, so there is no
# server to warm up and nothing to install.
#
# The free plan covers the two endpoints used here (/data/v1/search and
# /data/v1/estimate). It does NOT cover the Mapping Agent, Climatiq's AI
# matching endpoint, which answers 403 - and it is non-commercial only, with a
# monthly calculation quota that surfaces as 429 quota_exceeded.
CLIMATIQ_API_KEY=
